  [ 13] pushsymb 487 ............................ <#sprite>
  [ 16] eq ...................................... <tTarget.ilk = #sprite>
  [ 17] jmpifz [ 27] ............................ if tTarget.ilk = #sprite then / else
  [ 20] getparam 0 .............................. <tTarget>
  [ 22] setlocal 0 .............................. tSprite = tTarget
  [ 24] jmp [ 41]
  [ 27] getparam 0 .............................. <tTarget>
