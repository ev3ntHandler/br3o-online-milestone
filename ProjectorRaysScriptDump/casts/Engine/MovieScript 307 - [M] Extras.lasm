  [ 90] pushsymb 67 ............................. <#string>
  [ 92] eq ...................................... <tDataList.ilk = #string>
  [ 93] jmpifz [105] ............................ if tDataList.ilk = #string then
  [ 96] getparam 1 .............................. <tDataList>
  [ 98] pusharglist 1 ........................... <tDataList>
  [100] extcall 503 ............................. <value(tDataList)>
  [103] setparam 1 .............................. tDataList = value(tDataList)
  [105] getparam 1 .............................. <tDataList>
  [107] getobjprop 122 .......................... <tDataList.ilk>
  [109] pushsymb 541 ............................ <#propList>
  [112] nteq .................................... <tDataList.ilk <> #propList>
  [113] jmpifz [121] ............................ if tDataList.ilk <> #propList then
  [116] pushzero ................................ <0>
  [117] pusharglistnoret 1 ...................... <0>
  [119] extcall 52 .............................. return 0
  [121] pushsymb 54 ............................. <#none>
  [123] setlocal 1 .............................. tMode = #none
  [125] getparam 1 .............................. <tDataList>
  [127] pushsymb 1300 ........................... <#mode>
  [130] pusharglist 2 ........................... <tDataList, #mode>
  [132] objcall 105 ............................. <tDataList[#mode]>
  [134] getobjprop 122 .......................... <tDataList[#mode].ilk>
  [136] pushsymb 88 ............................. <#symbol>
  [138] eq ...................................... <tDataList[#mode].ilk = #symbol>
  [139] jmpifz [184] ............................ if tDataList[#mode].ilk = #symbol then
  [142] pushsymb 54 ............................. <#none>
  [144] pushsymb 3420 ........................... <#multiSample2x>
  [147] pushsymb 3421 ........................... <#multiSample4x>
  [150] pushsymb 3422 ........................... <#multiSample8x>
  [153] pushsymb 3423 ........................... <#multiSample16x>
