  [ 64] pushsymb 487 ............................ <#sprite>
  [ 67] eq ...................................... <gGame[#sprite].ilk = #sprite>
  [ 68] jmpifz [ 81] ............................ if gGame[#sprite].ilk = #sprite then / else
  [ 71] getglobal 43 ............................ <gGame>
  [ 73] getobjprop 487 .......................... <gGame.sprite>
  [ 76] setparam 0 .............................. tTarget = gGame.sprite
  [ 78] jmp [ 86]
  [ 81] pushzero ................................ <0>
  [ 82] pusharglistnoret 1 ...................... <0>
  [ 84] extcall 52 .............................. return 0
  [ 86] getparam 1 .............................. <tDataList>
