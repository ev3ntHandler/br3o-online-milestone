  [  7] setparam 1 .............................. tDataList = value(tDataList)
  [  9] getparam 1 .............................. <tDataList>
  [ 11] getobjprop 122 .......................... <tDataList.ilk>
  [ 13] pushsymb 541 ............................ <#propList>
  [ 16] nteq .................................... <tDataList.ilk <> #propList>
  [ 17] jmpifz [ 25] ............................ if tDataList.ilk <> #propList then
  [ 20] pusharglist 0 ........................... <[:]>
  [ 22] pushproplist ............................ <[:]>
  [ 23] setparam 1 .............................. tDataList = [:]
  [ 25] getparam 1 .............................. <tDataList>
  [ 27] pushsymb 598 ............................ <#type>
